#!/usr/bin/env python3
"""Put an agent's live facts on its Herdr terminal as labels, for the pane-account header.

  agent-meta set k=v ...                 set labels on this terminal ($HC_TERMINAL_ID), only if changed
  agent-meta codex-watch <pid> <home>    while <pid> lives, follow the Codex session log started in
                                         this folder under <home>/sessions and label its model,
                                         context and limits

Labels: agent.account, agent.model, agent.ctx (% used), agent.5h / agent.wk (% used) and
agent.5h_reset / agent.wk_reset (epoch seconds). Claude's come from bin/agent-statusline.
"""
import glob, json, os, subprocess, sys, time

TERM = os.environ.get("HC_TERMINAL_ID")
STATE = os.path.expanduser(f"~/.cache/herdr-mods/labels-{TERM}.json")


def set_labels(labels):
    """Write only what changed: Claude calls this on every status-line render."""
    if not TERM:
        return
    try:
        last = json.load(open(STATE))
    except (OSError, ValueError):
        last = {}
    changed = {k: str(v) for k, v in labels.items() if v is not None and last.get(k) != str(v)}
    if not changed:
        return
    shown = [f"{k}={v}" for k, v in changed.items() if not k.startswith("_")]  # _keys are bookkeeping
    if shown:
        subprocess.run(["hc", "label", TERM, *shown], capture_output=True, timeout=5)
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump({**last, **changed}, f)


def repo_root(path):
    """The git checkout (repo or worktree) a path is in, or None."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    while d and d != "/":
        if os.path.exists(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return None


def work_dir(transcript):
    """Where the agent is really working: the checkout of the file it last touched or the folder it
    last ran a command in. Agents edit and `cd` into other worktrees without leaving the folder
    they were started in, so the terminal's own folder is often wrong. Read from the transcript's tail."""
    import re
    try:
        size = os.path.getsize(transcript)
        with open(transcript, "rb") as f:
            f.seek(max(0, size - 400_000))
            lines = f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return None
    skip = (os.path.expanduser("~/.claude"), os.path.expanduser("~/.codex"), os.path.expanduser("~/.cache"), "/tmp", "/private/tmp", "/var", "/private/var")

    def from_input(inp):
        if not isinstance(inp, dict):
            return []
        out = [inp.get(k) for k in ("file_path", "notebook_path", "path", "workdir", "cwd")]
        cmd = inp.get("command") or inp.get("cmd") or ""
        if isinstance(cmd, list):
            cmd = " ".join(map(str, cmd))
        # the last folder a command moved into or pointed git at
        out += reversed(re.findall(r"""(?:\bcd|git\s+-C)\s+["']?(~?/[^\s"'&;|)]+)""", cmd))
        return [os.path.expanduser(o) for o in out if isinstance(o, str) and o.startswith(("/", "~/"))]

    for line in reversed(lines):
        if '"tool_use"' not in line and '"function_call"' not in line and '"custom_tool_call"' not in line:
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue
        inputs = []
        if e.get("type") == "response_item":  # Codex
            a = e.get("payload", {}).get("arguments") or e.get("payload", {}).get("input")
            try:
                inputs.append(json.loads(a) if isinstance(a, str) else a)
            except ValueError:
                pass
        else:
            content = (e.get("message") or {}).get("content")
            if isinstance(content, list):
                inputs += [c.get("input") for c in reversed(content) if isinstance(c, dict) and c.get("type") == "tool_use"]
        for inp in inputs:
            for path in from_input(inp):
                if path.startswith(skip):
                    continue
                root = repo_root(path)
                if root:
                    return root
    return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def codex_session(home, cwd, since):
    """The newest session log under <home>/sessions begun after `since` in folder `cwd`."""
    for f in sorted(glob.glob(f"{home}/sessions/*/*/*/rollout-*.jsonl"), key=os.path.getmtime, reverse=True):
        if os.path.getmtime(f) < since:
            break
        try:
            meta = json.loads(open(f).readline()).get("payload", {})
        except (OSError, ValueError):
            continue
        if meta.get("cwd") == cwd:
            return f
    return None


def codex_facts(path):
    facts, model = {}, None
    with open(path) as f:
        for line in f:
            if '"turn_context"' in line:
                try: model = json.loads(line)["payload"].get("model")
                except (ValueError, KeyError): pass
            elif '"token_count"' in line:
                try: p = json.loads(line)["payload"]
                except (ValueError, KeyError): continue
                info, rl = p.get("info") or {}, p.get("rate_limits") or {}
                last, win = info.get("last_token_usage") or {}, info.get("model_context_window")
                if win and last:
                    facts["agent.ctx"] = round(100 * last.get("input_tokens", 0) / win)
                for key in ("primary", "secondary"):
                    w = rl.get(key)
                    if not w: continue
                    short = "5h" if w.get("window_minutes", 0) <= 300 else "wk"
                    facts[f"agent.{short}"] = round(w.get("used_percent", 0))
                    if w.get("resets_at"): facts[f"agent.{short}_reset"] = int(w["resets_at"])
    if model:
        facts["agent.model"] = model
    return facts


def codex_watch(pid, home):
    home, cwd, since, path, turns = os.path.expanduser(home), os.getcwd(), time.time() - 5, None, None
    while alive(pid):
        path = path or codex_session(home, cwd, since)
        if path:
            try:
                sid = json.loads(open(path).readline()).get("payload", {}).get("id")
            except (OSError, ValueError):
                sid = None
            set_labels({**codex_facts(path), "agent.session": sid, "agent.transcript": path,
                        "agent.cwd": work_dir(path)})
            # A turn just ended: let agent-shift move this chat if the account is running low.
            done = sum(1 for line in open(path) if '"task_complete"' in line)
            if turns is not None and done > turns:
                subprocess.run(["agent-shift", "codex-turn", home, path], timeout=60)
            turns = done
        time.sleep(5)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "set":
        labels = dict(a.split("=", 1) for a in sys.argv[2:] if not a.startswith("--"))
        # --workdir-from=<transcript>: also label where the agent is really working (agent.cwd).
        src = next((a.split("=", 1)[1] for a in sys.argv[2:] if a.startswith("--workdir-from=")), None)
        if src and TERM:
            try:
                last = json.load(open(STATE))
            except (OSError, ValueError):
                last = {}
            size = str(os.path.getsize(src)) if os.path.exists(src) else ""
            if last.get("_wd_size") != size:  # only re-read when the transcript grew
                wd = work_dir(src)
                if wd:
                    labels["agent.cwd"] = wd
                labels["_wd_size"] = size
        set_labels(labels)
    elif cmd == "workdir":
        print(work_dir(sys.argv[2]) or "")
    elif cmd == "codex-watch":
        codex_watch(int(sys.argv[2]), sys.argv[3])
    else:
        sys.exit(__doc__)
