#!/usr/bin/env python3
"""Claude Code status line, and the feed for the Herdr pane header: which account this session is on, context used, and plan limits.

Set in Claude Code settings: {"statusLine": {"type": "command", "command": "agent-statusline"}}.
Account: matched by CLAUDE_CONFIG_DIR against the "usage.claude" entries in
~/.config/herdr-mods/config.json. Context and limits: from Claude Code's own status input; the account's email
from the cache `claude-usage` writes. This script never calls the network.
"""
import json, os, subprocess, sys, time

CONFIG = os.path.expanduser(os.environ.get("HERDR_MODS_CONFIG", "~/.config/herdr-mods/config.json"))
CACHE = os.path.expanduser("~/.cache/herdr-mods/usage.json")
DIM, RESET = "\033[2m", "\033[0m"
COL = {"ok": "\033[32m", "warn": "\033[33m", "bad": "\033[31m"}


def norm(p):
    return os.path.abspath(os.path.expanduser(p)) if p else None


def color(pct, pace=None):
    k = "bad" if pct >= 90 else "warn" if (pace is not None and pct > pace + 5) or pct >= 75 else "ok"
    return f"{COL[k]}{pct:.0f}%{RESET}"


def main():
    try:
        s = json.load(sys.stdin)
    except ValueError:
        s = {}
    me = norm(os.environ.get("CLAUDE_CONFIG_DIR"))
    try:
        accts = json.load(open(CONFIG)).get("usage", {}).get("claude", [])
    except (OSError, ValueError):
        accts = []
    label = next((a["label"] for a in accts if norm(a.get("config_dir")) == me), None) or "Claude"

    parts = [f"\033[1m{label}{RESET}"]
    try:
        cache = json.load(open(CACHE))
        acct = next((a for a in cache.get("accounts", []) if a.get("label") == label), None)
    except (OSError, ValueError):
        acct = None
    if acct and acct.get("email"):
        parts[0] += f" {DIM}{acct['email']}{RESET}"

    cw = s.get("context_window") or {}
    used = cw.get("used_percentage")
    if used is None and cw.get("context_window_size"):
        cur = cw.get("current_usage") or {}
        tok = sum(cur.get(k, 0) or 0 for k in ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        used = 100 * tok / cw["context_window_size"]
    model = (s.get("model") or {}).get("display_name")
    if model:
        parts.append(model)
    if used is not None:
        parts.append(f"ctx {color(used)}")

    now = time.time()
    live = s.get("rate_limits") or {}
    if live:  # this session's own account, straight from Claude Code
        for key, short, span in (("five_hour", "5h", 5 * 3600), ("seven_day", "wk", 7 * 86400)):
            w = live.get(key)
            if not w or w.get("used_percentage") is None:
                continue
            pace = 100 * max(0, min(1, 1 - (w["resets_at"] - now) / span)) if w.get("resets_at") else None
            parts.append(f"{short} {color(w['used_percentage'], pace)}")
    elif acct:
        for l in acct.get("limits", []):
            if "·" in l["name"]:
                continue
            short = "5h" if l["name"].startswith("5") else "wk"
            pace = None
            if l.get("resets_at"):
                end = time.mktime(time.strptime(l["resets_at"][:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone
                span = 5 * 3600 if short == "5h" else 7 * 86400
                pace = 100 * max(0, min(1, 1 - (end - now) / span))
            parts.append(f"{short} {color(l['percent'], pace)}")
    # Inside Herdr the pane header shows all of this, so feed it labels and print nothing.
    if os.environ.get("HC_TERMINAL_ID"):
        labels = {"agent.account": label, "agent.model": model,
                  "agent.ctx": round(used) if used is not None else None,
                  "agent.session": s.get("session_id"), "agent.transcript": s.get("transcript_path")}
        for key, short in (("five_hour", "5h"), ("seven_day", "wk")):
            w = live.get(key) or {}
            if w.get("used_percentage") is not None:
                labels[f"agent.{short}"] = round(w["used_percentage"])
                labels[f"agent.{short}_reset"] = w.get("resets_at")
            else:  # this account has no such limit: clear one left from another account
                labels[f"agent.{short}"] = ""
                labels[f"agent.{short}_reset"] = ""
        subprocess.run(["agent-meta", "set", *[f"{k}={v}" for k, v in labels.items() if v is not None],
                        *([f"--workdir-from={s['transcript_path']}"] if s.get("transcript_path") else [])], timeout=5)
        if not os.environ.get("AGENT_STATUSLINE_SHOW"):
            return
    print(f" {DIM}│{RESET} ".join(parts))


main()
