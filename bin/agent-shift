#!/usr/bin/env python3
"""Move an agent to another account on the same runtime when its own runs low, keeping its chat.

  agent-shift claude-hook            Claude Code Stop / StopFailure hook (reads the hook JSON on stdin)
  agent-shift codex-turn <home> <rollout>
                                     called by agent-meta codex-watch when a Codex turn ends
  agent-shift move <terminal> --to <account> ["prompt"] [--force]
                                     move the Claude agent in that terminal now (skips one with running
                                     background work unless --force); the prompt starts its next turn
  agent-shift status                 each account's use, where a low agent would go, and recent moves

At the end of a turn, if the account in use is at or above the threshold (default 90%) on its
5-hour or weekly limit, or the turn failed on a rate limit, the agent moves to the account on the
same runtime with the most headroom. Its transcript is copied into that account's folder when the
two differ, and agent-run restarts it in the same terminal with --resume. If every account on that
runtime is low, it stays and asks the lead on agent-bus. It never moves between Claude and Codex.

Config (~/.config/herdr-mods/config.json): "usage" lists the accounts; optional
"shift": {"threshold": 90, "cooldown_min": 10, "enabled": true}.
"""
import fcntl, json, os, shlex, shutil, signal, subprocess, sys, time

CONFIG = os.path.expanduser(os.environ.get("HERDR_MODS_CONFIG", "~/.config/herdr-mods/config.json"))
CACHE = os.path.expanduser("~/.cache/herdr-mods")
TERM = os.environ.get("HC_TERMINAL_ID")


def cfg():
    try:
        return json.load(open(CONFIG))
    except (OSError, ValueError):
        return {}


def norm(p):
    return os.path.realpath(os.path.expanduser(p)) if p else None


def load(path, default=None):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return default


def used(limits):
    """An account's worst main limit, in %: the 5-hour and the all-models weekly ones."""
    main = [l for l in limits if l.get("kind") not in ("weekly_scoped",)]
    return max((l.get("percent") or 0 for l in main), default=0)


def accounts(runtime):
    """[(label, used %, account entry)] from the config, with use from the usage cache."""
    c = cfg().get("usage", {}).get(runtime, [])
    cache = load(f"{CACHE}/usage.json", {})
    rows = {a["label"]: a for a in cache.get("accounts" if runtime == "claude" else "codex", [])}
    out = []
    for a in c:
        r = rows.get(a["label"])
        out.append((a["label"], used(r["limits"]) if r and not r.get("error") else None, a))
    return out


def settings():
    s = {"threshold": 90, "cooldown_min": 10, "enabled": True,
         "gap_sec": 45,        # at most one switch per runtime in this many seconds
         "per_agent": 3,       # % of headroom a just-moved agent is assumed to take on its new account
         "return": True, "return_below": 50}  # go back to the account it came from once that has reset
    s.update(cfg().get("shift", {}))
    if os.environ.get("AGENT_SHIFT_THRESHOLD"):  # for testing on one agent
        s["threshold"] = float(os.environ["AGENT_SHIFT_THRESHOLD"])
    return s


def live_used():
    """This terminal's own limits, fresher than the cache (from the pane-header labels)."""
    lab = load(f"{CACHE}/labels-{TERM}.json", {}) if TERM else {}
    vals = [float(lab[k]) for k in ("agent.5h", "agent.wk") if lab.get(k) not in (None, "")]
    return max(vals) if vals else None


def pick(runtime, current, cur_used, s):
    """(target entry, reason) or (None, why not)."""
    T = s["threshold"]
    accts = accounts(runtime)
    if cur_used is None:
        cur_used = next((u for l, u, _ in accts if l == current), None)
    if cur_used is None or cur_used < T:
        return None, None
    others = [(u + pending(runtime, l, s), l, a) for l, u, a in accts if l != current and u is not None]
    others = [o for o in others if o[0] < T]
    if not others:
        return None, f"every {runtime} account is at {T}% or more"
    u, l, a = min(others)
    return a, f"{current} at {round(cur_used)}%, {l} at {round(u)}%"


def moves():
    return [m for m in load(f"{CACHE}/moves.json", []) if time.time() - m["at"] < 86400]


def pending(runtime, label, s):
    """Headroom already spoken for: agents moved onto `label` in the last 5 minutes, before usage shows them."""
    n = sum(1 for m in moves() if m["runtime"] == runtime and m["to"] == label and time.time() - m["at"] < 300)
    return n * s["per_agent"]


def too_soon(runtime, s):
    return any(m["runtime"] == runtime and time.time() - m["at"] < s["gap_sec"] for m in moves())


def refresh_usage():
    """Fresh numbers for every account before choosing where to go (the cache can be 5 minutes old)."""
    try:
        subprocess.run(["claude-usage"], capture_output=True, timeout=25)
    except (OSError, subprocess.TimeoutExpired):
        pass


def busy(pid, term=None):
    term = term or TERM
    """Work the switch would kill: this agent's background shell commands and subagents."""
    ps = subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout
    rows = [l.split(None, 2) for l in ps.splitlines() if len(l.split(None, 2)) == 3]
    kids = {}
    for p, pp, cmd in rows:
        kids.setdefault(int(pp), []).append((int(p), cmd))
    mine, me = set(), os.getpid()
    while me and me != pid and me not in mine:  # the hook's own chain is not background work
        mine.add(me)
        me = next((int(pp) for p, pp, _ in rows if int(p) == me), None)
    todo, found = [pid], []
    while todo:
        for p, cmd in kids.get(todo.pop(), []):
            if p in mine:
                continue
            if "shell-snapshots" in cmd:  # how Claude Code runs a Bash tool command
                found.append(cmd[-60:])
            todo.append(p)
    try:
        ls = json.loads(subprocess.run(["herdr-app", "ls"], capture_output=True, text=True, timeout=10).stdout)
        for sp in ls.get("spaces", []):
            for t in sp.get("tabs", []):
                for x in t.get("terminals", []):
                    if x.get("terminal") == term and x.get("sub_agents"):
                        found.append(f"{len(x['sub_agents'])} subagent(s)")
    except (ValueError, OSError, subprocess.TimeoutExpired):
        pass
    return found


def decide(runtime, current, cur_used, s, forced=False):
    """(target, why) for this turn end: leave a low account, or return to the one it came from."""
    T = s["threshold"]
    if cur_used is None:
        cur_used = next((u for l, u, _ in accounts(runtime) if l == current), None)
    if cur_used is not None and cur_used >= T or forced:
        refresh_usage()
        return pick(runtime, current, 100 if forced else cur_used, s)
    origin = load(f"{CACHE}/shifted-{TERM}.json", {}).get("from")
    if s["return"] and origin and origin != current and cur_used is not None:
        u = next((u for l, u, _ in accounts(runtime) if l == origin), None)
        if u is not None and u < s["return_below"] and u + pending(runtime, origin, s) < cur_used:
            refresh_usage()
            row = next(((l, u, a) for l, u, a in accounts(runtime) if l == origin), None)
            if row and row[1] is not None and row[1] < s["return_below"]:
                return row[2], f"{origin} has reset ({round(row[1])}%), back from {current} ({round(cur_used)}%)"
    return None, None


def cooling(s):
    last = load(f"{CACHE}/shifted-{TERM}.json", {}).get("at", 0)
    return time.time() - last < s["cooldown_min"] * 60


def bus(to, state, msg):
    subprocess.run(["agent-bus", "post", "--to", to, "--state", state, "-m", msg], capture_output=True, timeout=15)


def ask_lead_once(runtime, why):
    key = f"{CACHE}/asked-{runtime}.json"
    if time.time() - load(key, {}).get("at", 0) < 3600:
        return
    json.dump({"at": time.time()}, open(key, "w"))
    bus("@lead", "question", f"Agents on {runtime} are running out: {why}. "
        f"Wait for a reset, or should some move to the other runtime?")


def agent_pid():
    run = load(f"{CACHE}/run-{TERM}.json", {}) if TERM else {}
    return run.get("pid"), bool(run)


def ancestor(name):
    pid = os.getppid()
    for _ in range(8):
        r = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True)
        if not r.stdout.strip():
            return None
        ppid, comm = r.stdout.strip().split(None, 1)
        if os.path.basename(comm) == name:
            return pid
        pid = int(ppid)
    return None


def shell_wrapped():
    """Herdr starts a tab's program inside the login shell (`... ; exec fish -li`), so the shell
    takes over the terminal when the agent exits and we can type the resume into it."""
    try:
        argv = json.loads(subprocess.run(["hc", "get", TERM], capture_output=True, text=True).stdout).get("argv", [])
    except ValueError:
        return False
    return any("exec $argv[1]" in a for a in argv)


def restart(req, line, current):
    """Stop the agent and start it again on the new account in the same terminal, then check it came back.
    Under agent-run: it relaunches from the shift file. Otherwise: `line` is typed into the shell left behind."""
    pid, wrapped = agent_pid()
    pid = ancestor(req["runtime"]) or pid
    if not pid:
        return False
    if not wrapped and not shell_wrapped():
        bus("@lead", "question", f"{TERM} is low ({req['reason']}) but can't be restarted in place; run: {line}")
        return False
    os.makedirs(CACHE, exist_ok=True)
    now = time.time()
    returning = load(f"{CACHE}/shifted-{TERM}.json", {}).get("from") == req["label"]
    json.dump({"at": now, "to": req["label"], "from": None if returning else current},
              open(f"{CACHE}/shifted-{TERM}.json", "w"))
    json.dump(moves() + [{"at": now, "runtime": req["runtime"], "from": current, "to": req["label"], "terminal": TERM,
                          "who": os.environ.get("AGENT_BUS_LANE") or os.environ.get("AGENT_BUS_LANE_PARENT"),
                          "why": req["reason"]}], open(f"{CACHE}/moves.json", "w"))
    if wrapped:
        json.dump(req, open(f"{CACHE}/shift-{TERM}.json", "w"))
    # In a terminal Herdr owns: Claude ends its hook's processes when it exits.
    subprocess.run(["hc", "run", "--bg", "--rm", "--no-parent", "--no-notify", "--name", f"shift-{TERM}", "--",
                    "agent-shift", "finish", TERM, str(pid), req["label"], "1" if wrapped else "0", line],
                   capture_output=True, timeout=15, env={k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"})
    return True


def finish(term, pid, label, wrapped, line):
    """Runs outside the agent: stop it, bring it back on `label`, and make sure it is really there."""
    def gone():
        try:
            os.kill(pid, 0)
            return False
        except OSError:
            return True

    def back():
        # agent-run records each launch; a new live pid on the right account means the agent is up.
        run = load(f"{CACHE}/run-{term}.json", {})
        if run.get("label") != label or run.get("pid") in (None, pid):
            return False
        try:
            os.kill(run["pid"], 0)
            return True
        except OSError:
            return False

    def wait(test, secs):
        end = time.time() + secs
        while time.time() < end:
            if test():
                return True
            time.sleep(0.5)
        return False

    def type_line():
        subprocess.run(["hc", "send", term, line], capture_output=True, timeout=30,
                       env={k: v for k, v in os.environ.items() if k != "HC_TERMINAL_ID"})  # no <hc from> wrapper

    time.sleep(1)
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    if not wait(gone, 30):
        os.kill(pid, signal.SIGKILL)
        wait(gone, 5)
    time.sleep(1)
    if not wrapped:
        type_line()
    if wait(back, 25):
        return
    type_line()  # once more: whatever happened, the tab should now be at a shell
    if wait(back, 25):
        return
    msg = f"{term} did not come back after moving to {label}. In that tab run: {line}"
    bus("@lead", "blocked", msg)
    subprocess.run(["osascript", "-e", f'display notification {json.dumps(msg[:200])} with title "agent-shift"'],
                   capture_output=True)


KEEP = {"claude": ({"--dangerously-skip-permissions"}, {"--model", "--permission-mode", "--settings", "--add-dir", "--effort"}),
        "codex": ({"--yolo", "--full-auto", "--dangerously-bypass-approvals-and-sandbox"},
                  {"-m", "--model", "-p", "--profile", "-s", "--sandbox", "-a", "--ask-for-approval"})}


def flags_of(pid, runtime):
    """A running agent's launch flags worth carrying over (permission mode, model, ...). Read from `ps`,
    which doesn't quote, so only known flags are kept: words of the opening prompt must not slip in."""
    toks = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout.split()
    plain, valued = KEEP[runtime]
    out, i = [], 1
    while i < len(toks):
        if toks[i] in plain:
            out.append(toks[i])
        elif toks[i] in valued and i + 1 < len(toks):
            out += toks[i:i + 2]
            i += 1
        i += 1
    return out


def kept_flags(runtime):
    pid = ancestor(runtime)
    return flags_of(pid, runtime) if pid else []


def env_line(env, unset, argv):
    """`env [-u X] A=1 cmd ...` as one shell-quoted line, keeping the agent's bus lane."""
    keep = {k: os.environ[k] for k in ("AGENT_BUS_LANE", "AGENT_BUS_LANE_PARENT", "AGENT_SHIFT_THRESHOLD") if os.environ.get(k)}
    parts = ["env"] + [x for k in unset for x in ("-u", k)] + [f"{k}={v}" for k, v in {**keep, **env}.items()] + argv
    return " ".join(shlex.quote(p) for p in parts)


# ---- Claude ---------------------------------------------------------------------------------

def claude_current():
    me = norm(os.environ.get("CLAUDE_CONFIG_DIR"))
    for a in cfg().get("usage", {}).get("claude", []):
        if norm(a.get("config_dir")) == me:
            return a["label"], a
    return None, None


def carry_trust(src_dir, dst_dir, folder):
    """A folder the agent already works in is trusted on the new account too, so the resumed
    chat doesn't stop at Claude's "trust this folder?" prompt."""
    def store(d):
        return os.path.join(os.path.expanduser(d), ".claude.json") if d else os.path.expanduser("~/.claude.json")
    src, dst = load(store(src_dir), {}), load(store(dst_dir), None)
    if dst is None or not folder or not src.get("projects", {}).get(folder, {}).get("hasTrustDialogAccepted"):
        return
    proj = dst.setdefault("projects", {}).setdefault(folder, {})
    if proj.get("hasTrustDialogAccepted"):
        return
    proj["hasTrustDialogAccepted"] = True
    tmp = store(dst_dir) + ".agent-shift.tmp"
    with open(tmp, "w") as f:
        json.dump(dst, f, indent=2)
    os.replace(tmp, store(dst_dir))


def claude_move(transcript, target):
    """Copy the chat into the target account's folder if it uses a different one."""
    src_root = norm(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude")
    dst_root = norm(target.get("config_dir") or "~/.claude")
    if src_root == dst_root or not transcript:
        return
    rel = os.path.relpath(transcript, src_root)
    dst = os.path.join(dst_root, rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy2(transcript, dst)
    side = transcript[:-len(".jsonl")]  # subagent transcripts, tool results
    if os.path.isdir(side):
        shutil.copytree(side, dst[:-len(".jsonl")], dirs_exist_ok=True)


def claude_hook():
    h = json.load(sys.stdin) if not sys.stdin.isatty() else {}
    s = settings()
    if not (TERM and s["enabled"]) or h.get("stop_hook_active"):
        return
    current, _ = claude_current()
    if not current:
        return
    failed = h.get("hook_event_name") == "StopFailure"
    rate = failed and "rate" in json.dumps(h).lower()
    if cooling(s) and not rate:
        return
    with open(f"{CACHE}/shift.lock", "w") as lock:  # one agent decides at a time
        fcntl.flock(lock, fcntl.LOCK_EX)
        if too_soon("claude", s) and not rate:
            return  # another agent just moved; this one looks again at its next turn end
        target, why = decide("claude", current, live_used(), s, forced=rate)
        if target and not rate:
            work = busy(ancestor("claude") or agent_pid()[0] or 0)
            if work:
                return  # it would be killed; try again when the next turn ends
        return claude_switch(h, s, current, target, why, failed)


def claude_switch(h, s, current, target, why, failed):
    if not target:
        if why:
            ask_lead_once("claude", why)
        return
    sid = h.get("session_id")
    claude_move(h.get("transcript_path"), target)
    carry_trust(os.environ.get("CLAUDE_CONFIG_DIR"), target.get("config_dir"), h.get("cwd"))
    cd = target.get("config_dir")
    req = {"runtime": "claude", "label": target["label"], "resume": sid, "reason": why,
           "env": {"CLAUDE_CONFIG_DIR": os.path.expanduser(cd)} if cd else {},
           "unset": [] if cd else ["CLAUDE_CONFIG_DIR"],
           "prompt": "You were moved to another account after a rate limit. Carry on where you left off." if failed else None}
    line = env_line(req["env"], req["unset"], ["agent-run", target["label"], "claude", *kept_flags("claude"), "--resume", sid]
                    + ([req["prompt"]] if req["prompt"] else []))
    if restart(req, line, current):
        bus("@here", "fyi", f"{os.environ.get('AGENT_BUS_LANE') or os.environ.get('AGENT_BUS_LANE_PARENT') or 'agent'} "
            f"moved Claude {current} → {target['label']} ({why}).")


# ---- Codex ----------------------------------------------------------------------------------

def codex_turn(home, rollout):
    s = settings()
    if not (TERM and s["enabled"]) or cooling(s):
        return
    home = norm(home)
    current = next((a["label"] for a in cfg().get("usage", {}).get("codex", []) if norm(a.get("home")) == home), None)
    if not current:
        return
    with open(f"{CACHE}/shift.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if too_soon("codex", s):
            return
        target, why = decide("codex", current, live_used(), s)
        if not target:
            if why:
                ask_lead_once("codex", why)
            return
        codex_switch(home, rollout, current, target, why)


def codex_switch(home, rollout, current, target, why):
    sid = json.loads(open(rollout).readline()).get("payload", {}).get("id")
    dst_home = os.path.expanduser(target["home"])
    rel = os.path.relpath(rollout, f"{home}/sessions")
    dst = os.path.join(dst_home, "sessions", rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copy2(rollout, dst)
    req = {"runtime": "codex", "label": target["label"], "resume": sid, "reason": why,
           "codex_home": dst_home, "env": {"CODEX_HOME": dst_home}}
    line = env_line({}, [], ["agent-run", "--codex-home", dst_home, target["label"], "env", f"CODEX_HOME={dst_home}", "codex", "resume", sid, *kept_flags("codex")])
    if restart(req, line, current):
        bus("@here", "fyi", f"Codex agent moved {current} → {target['label']} ({why}).")


def move(term, to, prompt=None, force=False):
    """Move the Claude agent in terminal `term` to account `to` now, from outside it."""
    import re
    t = json.loads(subprocess.run(["hc", "get", term], capture_output=True, text=True).stdout)
    ps = subprocess.run(["ps", "-axo", "pid=,ppid=,comm="], capture_output=True, text=True).stdout
    rows = [l.split(None, 2) for l in ps.splitlines() if len(l.split(None, 2)) == 3]
    todo, pid = [t["pid"]], None
    while todo and not pid:
        cur = todo.pop(0)
        for p, pp, comm in rows:
            if int(pp) == cur:
                if os.path.basename(comm) == "claude":
                    pid = int(p)
                todo.append(int(p))
    if not pid:
        return f"{term}: no Claude agent running there"
    full = subprocess.run(["ps", "eww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True).stdout
    env = dict(re.findall(r"\b(AGENT_BUS_LANE|AGENT_BUS_LANE_PARENT|CLAUDE_CONFIG_DIR)=(\S+)", full))
    accts = cfg().get("usage", {}).get("claude", [])
    current = next((a["label"] for a in accts if norm(a.get("config_dir")) == norm(env.get("CLAUDE_CONFIG_DIR"))), None)
    target = next((a for a in accts if a["label"] == to), None)
    if not target:
        return f"{term}: no Claude account named {to}"
    if current == to:
        return f"{term}: already on {to}"
    work = busy(pid, term)
    if work and not force:
        return f"{term}: left alone, it has running work ({'; '.join(work)[:80]})"
    root = os.path.expanduser(env.get("CLAUDE_CONFIG_DIR") or "~/.claude")
    sid = load(f"{root}/sessions/{pid}.json", {}).get("sessionId") or t["labels"].get("agent.session")
    if not sid:
        return f"{term}: can't tell which chat it is"
    keep = flags_of(pid, "claude")
    carry_trust(env.get("CLAUDE_CONFIG_DIR"), target.get("config_dir"), t.get("cwd"))
    cd = target.get("config_dir")
    why = f"moved by hand from {current}"
    req = {"runtime": "claude", "label": to, "resume": sid, "reason": why, "prompt": prompt,
           "env": {"CLAUDE_CONFIG_DIR": os.path.expanduser(cd)} if cd else {}, "unset": [] if cd else ["CLAUDE_CONFIG_DIR"]}
    lanes = [f"{k}={v}" for k, v in env.items() if k.startswith("AGENT_BUS")]
    parts = ["env"] + ([] if cd else ["-u", "CLAUDE_CONFIG_DIR"]) + lanes + [f"{k}={v}" for k, v in req["env"].items()] \
        + ["agent-run", to, "claude", *keep, "--resume", sid] + ([prompt] if prompt else [])
    line = " ".join(shlex.quote(x) for x in parts)
    run = load(f"{CACHE}/run-{term}.json", {})
    wrapped = bool(run)
    now = time.time()
    json.dump({"at": now, "to": to, "from": None}, open(f"{CACHE}/shifted-{term}.json", "w"))  # by hand: don't drift back
    json.dump(moves() + [{"at": now, "runtime": "claude", "from": current, "to": to, "terminal": term,
                          "who": env.get("AGENT_BUS_LANE") or env.get("AGENT_BUS_LANE_PARENT"), "why": why}],
              open(f"{CACHE}/moves.json", "w"))
    if wrapped:
        json.dump(req, open(f"{CACHE}/shift-{term}.json", "w"))
    finish(term, pid, to, wrapped, line)
    ok = load(f"{CACHE}/run-{term}.json", {}).get("label") == to
    return f"{term}: {current} → {to} {'ok' if ok else 'DID NOT COME BACK; run: ' + line}"


def status():
    s = settings()
    print(f"threshold {s['threshold']}%  cooldown {s['cooldown_min']}m  {'on' if s['enabled'] else 'OFF'}")
    for rt in ("claude", "codex"):
        accts = accounts(rt)
        for l, u, _ in accts:
            t, why = pick(rt, l, 100, s)
            print(f"  {rt:6} {l:9} {'?' if u is None else f'{u:.0f}%':>5}   if low → {t['label'] if t else why}")
    for m in moves()[-8:]:
        print(f"  {time.strftime('%H:%M', time.localtime(m['at']))}  {m.get('who') or m['terminal']}: "
              f"{m['runtime']} {m['from']} → {m['to']} ({m['why']})")


def main():
    a = sys.argv[1:]
    if a[:1] == ["claude-hook"]:
        try:
            claude_hook()
        except Exception as e:  # a hook must never break the agent's turn
            print(f"agent-shift: {e}", file=sys.stderr)
    elif a[:1] == ["codex-turn"] and len(a) == 3:
        try:
            codex_turn(a[1], a[2])
        except Exception as e:
            print(f"agent-shift: {e}", file=sys.stderr)
    elif a[:1] == ["finish"] and len(a) == 6:
        finish(a[1], int(a[2]), a[3], a[4] == "1", a[5])
    elif a[:1] == ["move"] and len(a) >= 4 and a[2] == "--to":
        rest = a[4:]
        print(move(a[1], a[3], prompt=next((x for x in rest if not x.startswith("--")), None), force="--force" in rest))
    elif a[:1] == ["status"]:
        status()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
